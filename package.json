{
  "name": "tanstack-books",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "preview:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler dev",
    "deploy:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler deploy",
    "deploy:netlify": "NETLIFY=1 pnpm build && npx --yes netlify deploy --prod --no-build",
    "deploy:vercel": "pnpm build && npx --yes vercel deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.41",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@netlify/blobs": "^11.1.4",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/functions": "^3.9.11",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.150.0"
  }
}
